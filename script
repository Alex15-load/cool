    if os.clock() - lastJump < 0.2 then
        return
    end

    lastJump = os.clock()

    humanoid:ChangeState(
        Enum.HumanoidStateType.Jumping
    )
end)

--============================================
-- ESP (R6 + R15)
--============================================

local espButton

local function removeESP(target)

    local objects = espObjects[target]

    if not objects then
        return
    end

    if objects.highlight then
        objects.highlight:Destroy()
    end

    if objects.billboard then
        objects.billboard:Destroy()
    end

    espObjects[target] = nil
end

local function createESP(target)

    if target == player then
        return
    end

    removeESP(target)

    local char = target.Character

    if not char then
        return
    end

    local targetHumanoid =
        char:FindFirstChildOfClass("Humanoid")

    local head = char:FindFirstChild("Head")

    if not targetHumanoid or not head then
        return
    end

    -- AVATAR OUTLINE

    local highlight = Instance.new("Highlight")

    highlight.Name = "AlexESPHighlight"
    highlight.Adornee = char
    highlight.FillColor = Color3.fromRGB(255, 30, 40)
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 30, 40)
    highlight.OutlineTransparency = 0
    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Parent = char

    -- BILLBOARD

    local billboard = Instance.new("BillboardGui")

    billboard.Name = "AlexESPInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(270, 55)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = playerGui

    -- DISPLAY NAME

    local name = Instance.new("TextLabel")

    name.Size = UDim2.new(1, 0, 0, 27)
    name.BackgroundTransparency = 1
    name.TextColor3 = Color3.fromRGB(255, 45, 45)
    name.TextStrokeTransparency = 0
    name.Font = Enum.Font.GothamBold
    name.TextSize = 14
    name.Text = target.DisplayName ..
        " (@" .. target.Name .. ")"

    name.Parent = billboard

    -- DISTANCE

    local distance = Instance.new("TextLabel")

    distance.Size = UDim2.new(1, 0, 0, 23)
    distance.Position = UDim2.fromOffset(0, 27)
    distance.BackgroundTransparency = 1
    distance.TextColor3 = Color3.new(1, 1, 1)
    distance.TextStrokeTransparency = 0
    distance.Font = Enum.Font.GothamBold
    distance.TextSize = 13
    distance.Text = "..."

    distance.Parent = billboard

    espObjects[target] = {
        highlight = highlight,
        billboard = billboard,
        distance = distance,
        character = char
    }
end

local function updateESP()

    if not espEnabled then
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= player then

            local char = target.Character
            local objects = espObjects[target]

            if char then

                if not objects or
                    objects.character ~= char then

                    createESP(target)
                    objects = espObjects[target]
                end

                if objects and root then

                    local targetRoot =
                        char:FindFirstChild("HumanoidRootPart")

                    if targetRoot then

                        local studs =
                            (root.Position -
                            targetRoot.Position).Magnitude

                        objects.distance.Text =
                            tostring(math.floor(studs)) ..
                            " studs"
                    end
                end

            elseif objects then

                removeESP(target)
            end
        end
    end
end

local function toggleESP()

    espEnabled = not espEnabled

    if espEnabled then

        for _, target in ipairs(Players:GetPlayers()) do

            if target ~= player then
                createESP(target)
            end
        end

        espConnection =
            RunService.RenderStepped:Connect(updateESP)

        espButton.Text = "ESP : ON"

    else

        if espConnection then
            espConnection:Disconnect()
            espConnection = nil
        end

        for target in pairs(espObjects) do
            removeESP(target)
        end

        espButton.Text = "ESP : OFF"
    end
end

espButton = makeButton("ESP : OFF", toggleESP)

--============================================
-- PLAYER CONNECTIONS
--============================================

local function connectPlayer(target)

    if target == player then
        return
    end

    target.CharacterAdded:Connect(function()

        task.wait(1)

        if espEnabled then
            createESP(target)
        end
    end)

    if espEnabled and target.Character then
        createESP(target)
    end
end

Players.PlayerAdded:Connect(connectPlayer)

for _, target in ipairs(Players:GetPlayers()) do
    connectPlayer(target)
end

Players.PlayerRemoving:Connect(function(target)
    removeESP(target)
end)

