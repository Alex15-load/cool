-- INPUT CREATOR

local function makeInput(label, value, callback)

    local holder = Instance.new("Frame")

    holder.Size = UDim2.new(1, -8, 0, 55)
    holder.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    holder.Parent = content

    Instance.new("UICorner", holder)

    local name = Instance.new("TextLabel")

    name.Size = UDim2.new(0.55, 0, 1, 0)
    name.Position = UDim2.fromOffset(10, 0)
    name.BackgroundTransparency = 1
    name.Text = label
    name.TextColor3 = Color3.new(1, 1, 1)
    name.Font = Enum.Font.GothamBold
    name.TextSize = 13
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = holder

    local box = Instance.new("TextBox")

    box.Size = UDim2.new(0.3, 0, 0, 34)
    box.Position = UDim2.new(0.66, 0, 0.5, -17)
    box.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Text = tostring(value)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 16
    box.ClearTextOnFocus = false
    box.Parent = holder

    Instance.new("UICorner", box)

    local currentValue = value

    box.FocusLost:Connect(function()

        local number = tonumber(box.Text)

        if number then
            number = math.clamp(number, 1, 300)
            currentValue = number
            box.Text = tostring(number)
            callback(number)
        else
            box.Text = tostring(currentValue)
        end
    end)

    return box
end

--============================================
-- FLY (R6 + R15)
--============================================

local flyButton

local function stopFly()

    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    if flyAttachment then
        flyAttachment:Destroy()
        flyAttachment = nil
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(
            Enum.HumanoidStateType.GettingUp
        )
    end

    if flyButton then
        flyButton.Text = "FLY : OFF [E]"
    end
end

local function startFly()

    if not root or not humanoid then
        return
    end

    if flying then
        return
    end

    flying = true

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.MaxForce = math.huge
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("AlignOrientation")
    flyGyro.Attachment0 = flyAttachment
    flyGyro.Mode =
        Enum.OrientationAlignmentMode.OneAttachment
    flyGyro.MaxTorque = math.huge
    flyGyro.Responsiveness = 15
    flyGyro.Parent = root

    flyButton.Text = "FLY : ON [E]"

    flyConnection = RunService.Heartbeat:Connect(function()

        if not character or not root or not root.Parent then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        flyVelocity.VectorVelocity =
            direction * flySpeed

        flyGyro.CFrame = CFrame.lookAt(
            Vector3.zero,
            camera.CFrame.LookVector
        )
    end)
end

local function toggleFly()

    if flying then
        stopFly()
    else
        startFly()
    end
end

flyButton = makeButton("FLY : OFF [E]", toggleFly)

