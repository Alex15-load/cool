local rigButton

local function checkRig()

    if not humanoid then

        setStatus("Personaggio non ancora caricato.")

        return
    end

    if humanoid.RigType ==
        Enum.HumanoidRigType.R6 then

        rigButton.Text = "RIG : R6"

        setStatus(
            "R6 RILEVATO - Compatibile con Alex Script!"
        )

    elseif humanoid.RigType ==
        Enum.HumanoidRigType.R15 then

        rigButton.Text = "RIG : R15"

        setStatus(
            "R15 RILEVATO - Compatibile con Alex Script!"
        )
    end
end

rigButton = makeButton(
    "CHECK RIG : R6 / R15",
    checkRig
)

--============================================
-- KEYBOARD SHORTCUTS
--============================================

UIS.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.E then

        toggleFly()

    elseif input.KeyCode == Enum.KeyCode.N then

        toggleNoclip()

    elseif input.KeyCode == Enum.KeyCode.RightShift then

        main.Visible = not main.Visible
        reopen.Visible = not main.Visible
    end
end)

--============================================
-- RESPAWN MANAGEMENT
--============================================

player.CharacterAdded:Connect(function(char)

    stopFly()

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    noclip = false
    restoreCollisions()

    if noclipButton then
        noclipButton.Text = "NOCLIP : OFF [N]"
    end

    setupCharacter(char)

    task.wait(1)

    if espEnabled then

        for _, target in ipairs(Players:GetPlayers()) do

            if target ~= player then
                createESP(target)
            end
        end
    end

    if rigButton then
        rigButton.Text = "CHECK RIG : R6 / R15"
    end
end)

